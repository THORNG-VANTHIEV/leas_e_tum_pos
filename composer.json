{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:pos": [
            "@php artisan test tests/Feature/Documents tests/Feature/Printing"
        ],
        "test:kitchen": [
            "@php artisan test tests/Feature/Kds"
        ],
        "test:floor": [
            "@php artisan test tests/Feature/Floor"
        ],
        "test:catalog": [
            "@php artisan test tests/Feature/Catalog"
        ],
        "test:purchases": [
            "@php artisan test tests/Feature/Purchases"
        ],
        "test:expenses": [
            "@php artisan test tests/Feature/Expenses"
        ],
        "test:customers": [
            "@php artisan test tests/Feature/Customers"
        ],
        "test:reports": [
            "@php artisan test tests/Feature/Reports tests/Feature/Periods"
        ],
        "test:users": [
            "@php artisan test tests/Feature/Users tests/Feature/Auth tests/Feature/Approvals tests/Feature/Audit"
        ],
        "test:backups": [
            "@php artisan test tests/Feature/Backups"
        ],
        "test:unit": [
            "@php artisan test tests/Unit"
        ],
        "test:smoke": [
            "@php artisan test tests/Feature/Smoke"
        ],
        "test:types": [
            "npx tsc --noEmit -p ."
        ],
        "check": [
            "@test:types",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test:pos": "POS checkout, hold table, void, delivery apps, invoices & printing",
        "test:kitchen": "Kitchen tickets and KDS",
        "test:floor": "Floor plan and tables",
        "test:catalog": "Products, units, categories",
        "test:purchases": "Purchases and suppliers",
        "test:expenses": "Expenses and cash drawer",
        "test:customers": "Customers and loyalty",
        "test:reports": "Sales reports and accounting periods",
        "test:users": "Login, staff, permissions, approvals, audit trail",
        "test:backups": "Backup, restore and daily backup command",
        "test:unit": "Money and calculator unit tests",
        "test:smoke": "Open every page for admin, supervisor and cashier",
        "test:types": "TypeScript type check of the frontend",
        "check": "Type check + full test suite (run before committing)"
    }
}
